# ==============================================================================
# Nirma Calling Assistant — Environment Configuration Template
# Copy this file to .env and populate with production / staging secrets.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application & Environment
APP_NAME="Nirma Calling Assistant"
APP_ENV=development                       # 'development' | 'staging' | 'production'
DEBUG=false
LOG_LEVEL=INFO

# Institutional Domain & Networking
# Production domain allocated by Nirma University (e.g., https://calls.nirmauni.ac.in)
BASE_URL=https://calls.nirmauni.ac.in
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://calls.nirmauni.ac.in

# Database Configuration (PostgreSQL 15)
# FastAPI async driver (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_calls
# Celery sync driver (psycopg)
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_calls

# Cache & Message Broker (Redis 7)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Telephony Carrier Settings
# Set TELEPHONY_PROVIDER to 'plivo' or 'twilio' to switch carriers seamlessly
TELEPHONY_PROVIDER=plivo                   # 'plivo' | 'twilio'
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_CALLER_ID=+91XXXXXXXXXX              # Registered Indian DID number

# Twilio Telephony (Alternative / Sandbox Testing)
TWILIO_ACCOUNT_SID=your_twilio_account_sid # Starts with AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CALLER_ID=+1XXXXXXXXXX              # Registered Twilio E.164 phone number

# AI Pipeline — Local Engines
OLLAMA_BASE_URL=http://ollama:11434       # Local Ollama service
OLLAMA_MODEL=qwen3:14b                    # Quantized 14B model (Q4_K_M)
INDIC_CONFORMER_MODEL_PATH=/models/indicconformer.nemo
INDIC_F5_MODEL_PATH=/models/indicf5.pt

# AI Pipeline — Cloud Fallback Providers
SARVAM_API_KEY=your_sarvam_api_key        # Cloud STT fallback (100 free min/day at sarvam.ai)
GROQ_API_KEY=your_groq_api_key            # Cloud LLM fallback (14,400 free req/day at groq.com)
GEMINI_API_KEY=your_gemini_api_key        # Google Gemini API key for LLM reasoning (aistudio.google.com)
GEMINI_TTS_API_KEY=your_gemini_tts_key    # Dedicated Google Gemini API key for TTS audio synthesis (optional)
GEMINI_MODEL=gemini-3.8-flash             # Primary Gemini LLM (e.g. gemini-3.8-flash)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite # Sub-second fallback Gemini LLM
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts  # Native studio audio synthesis model

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440           # 24 Hours
REFRESH_TOKEN_EXPIRE_DAYS=7                # 7 Days

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=call-recordings
